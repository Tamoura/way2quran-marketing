# Resend email provider
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Default From address for outbound emails
# Must match a domain verified in Resend (Domains tab)
RESEND_FROM_EMAIL=Way2Quran Marketing <hello@way2quran.com>

# Resend Audience ID for the main marketing list
# Create an Audience in Resend dashboard → copy the ID here
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Internal email address that receives contact form alerts
INTERNAL_EMAIL=team@way2quran.com

# Secret used to sign unsubscribe tokens (run: openssl rand -hex 32)
UNSUBSCRIBE_SECRET=change-me-to-a-random-hex-string

# Public base URL of the app (used to build unsubscribe links)
# In Vercel this is auto-set via VERCEL_URL; override for custom domains
NEXT_PUBLIC_BASE_URL=https://way2quran.com
